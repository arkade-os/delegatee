              },
              "leaves": [
                {
                  "name": "claim",
                  "asm": [
                    "OP_SIZE",
                    "32",
                    "OP_EQUALVERIFY",
                    "OP_HASH160",
                    "<preimageHash>",
                    "OP_EQUAL",
                    "OP_VERIFY",
