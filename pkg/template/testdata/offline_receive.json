{
  "format": "template/v1",
  "type": "virtual",
  "variables": {"taptree": "bytes", "receiver_program": "bytes32", "terms": "bytes"},
  "inputs": [
    {
      "name": "htlc",
      "contract": {
        "definition": {
          "contractName": "CovenantClaim",
          "constructorInputs": [{"name": "preimageHash", "type": "bytes20"}, {"name": "receiverProgram", "type": "bytes32"}],
          "structs": [],
          "functions": [
            {
              "name": "claim",
              "arkade": {
                "inputs": [],
                "asm": [
                  "OP_PUSHCURRENTINPUTINDEX",
                  "OP_DUP",
                  "OP_INSPECTOUTPUTSCRIPTPUBKEY",
                  "1",
                  "OP_EQUALVERIFY",
                  "<receiverProgram>",
                  "OP_EQUALVERIFY",
                  "OP_INSPECTOUTPUTVALUE",
                  "OP_PUSHCURRENTINPUTINDEX",
                  "OP_INSPECTINPUTVALUE",
                  "OP_GREATERTHANOREQUAL"
