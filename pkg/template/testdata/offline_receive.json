  ],
  "outputs": [
    {
      "name": "payout",
      "index": 0,
      "value": {"from": "htlc"},
      "locking": "5120$(<terms> 32 32 OP_SUBSTR <receiver_program> OP_EQUALVERIFY OP_PUSHCURRENTINPUTINDEX OP_INSPECTINPUTVALUE <terms> OP_SIZE 64 OP_SUB OP_RIGHT OP_DUP 0 OP_GREATERTHAN OP_VERIFY OP_GREATERTHANOREQUAL OP_VERIFY <receiver_program>)",
