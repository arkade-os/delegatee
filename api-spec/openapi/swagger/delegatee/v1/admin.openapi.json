  "components": {
    "schemas": {
      "Any": {
        "type": "object",
        "description": "Any contains an arbitrary schema along with a URL to help identify the type of the schema.",
        "properties": {
          "@type": {
            "type": "string",
            "description": "A URL/resource name that uniquely identifies the type of the schema."
          }
        }
      },
      "Artifact": {
        "title": "Artifact",
        "type": "object",
        "properties": {
          "createdAt": {
            "type": "integer",
            "format": "int64"
          },
          "document": {
            "type": "string"
          },
          "id": {
            "type": "string"
          }
        }
      },
      "Asset": {
        "title": "Asset",
        "type": "object",
        "properties": {
          "amount": {
            "type": "integer",
            "format": "uint64"
          },
          "assetId": {
            "type": "string"
          }
        }
      },
      "CancelDelegationRequest": {
        "title": "CancelDelegationRequest",
        "type": "object",
        "properties": {
          "address": {
            "type": "string"
          },
          "id": {
            "type": "integer",
            "description": "id, when set, takes precedence over address.",
            "format": "int64"
          }
        }
      },
      "CancelDelegationResponse": {
        "title": "CancelDelegationResponse",
        "type": "object"
      },
      "Delegation": {
        "title": "Delegation",
        "type": "object",
        "description": "Delegation is an instance of a template.",
        "properties": {
          "address": {
            "type": "string",
            "description": "address is slot 0's address for a watch, empty otherwise."
          },
          "createdAt": {
            "type": "integer",
            "format": "int64"
          },
          "expiresAt": {
            "type": "integer",
            "description": "expires_at is 0 when the delegation never expires.",
            "format": "int64"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "parentId": {
            "type": "integer",
            "description": "parent_id is the delegation whose settled transaction advertised this one, 0 for a watch.",
            "format": "int64"
          },
          "slots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Slot"
            }
          },
          "status": {
            "type": "string",
            "description": "status is active, cancelled, expired or done."
          },
          "templateId": {
            "type": "string"
          },
          "updatedAt": {
            "type": "integer",
            "format": "int64"
          },
          "variables": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "DelegationSummary": {
        "title": "DelegationSummary",
        "type": "object",
        "properties": {
          "delegation": {
            "$ref": "#/components/schemas/Delegation"
          },
          "lastRenewal": {
            "$ref": "#/components/schemas/Renewal"
          },
          "managed": {
            "type": "boolean",
            "description": "managed is false when this instance cannot renew the delegation; unmanaged_reason says why."
          },
          "nextBatchAt": {
            "type": "integer",
            "format": "int64"
          },
          "nextDeadline": {
            "type": "integer",
            "description": "next_deadline is the latest the soonest vtxo is submitted; next_batch_at the planned batch it joins, 0 without a plan.",
            "format": "int64"
          },
          "nextExpiry": {
            "type": "integer",
            "format": "int64"
          },
          "nextRenewalAt": {
            "type": "integer",
            "format": "int64"
          },
          "renewing": {
            "type": "boolean",
            "description": "renewing is true while a session holds the delegation's coins."
          },
          "totalAmount": {
            "type": "integer",
            "format": "uint64"
          },
          "unmanagedReason": {
            "type": "string"
          },
          "vtxoCount": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "DeleteArtifactRequest": {
        "title": "DeleteArtifactRequest",
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        }
      },
      "DeleteArtifactResponse": {
        "title": "DeleteArtifactResponse",
