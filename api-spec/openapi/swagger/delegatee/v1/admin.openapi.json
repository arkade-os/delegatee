              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterStreamResponse"
                }
              }
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/stream/{id}/cancel": {
      "post": {
        "tags": [
          "AdminService"
        ],
        "description": "CancelStream stops a stream; registering it again fails while it stays cancelled.",
        "operationId": "AdminService_CancelStream",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "title": "CancelStreamRequest",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "a successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CancelStreamResponse"
                }
              }
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/streams": {
      "get": {
        "tags": [
          "AdminService"
        ],
        "description": "ListStreams lists the streams of every status, oldest first.",
        "operationId": "AdminService_ListStreams",
        "responses": {
          "200": {
            "description": "a successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListStreamsResponse"
                }
              }
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/template/{id}": {
      "post": {
        "tags": [
          "AdminService"
        ],
        "description": "UpdateTemplate sets a template's status; activating resets its failures.",
        "operationId": "AdminService_UpdateTemplate",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "title": "UpdateTemplateRequest",
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "description": "status is active or disabled."
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "a successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpdateTemplateResponse"
                }
              }
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "AdminService"
        ],
        "description": "DeleteTemplate fails with FailedPrecondition while a delegation references the template.",
        "operationId": "AdminService_DeleteTemplate",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "a successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteTemplateResponse"
                }
              }
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Any": {
        "type": "object",
        "description": "Any contains an arbitrary schema along with a URL to help identify the type of the schema.",
        "properties": {
          "@type": {
            "type": "string",
            "description": "A URL/resource name that uniquely identifies the type of the schema."
          }
        }
      },
      "Artifact": {
        "title": "Artifact",
        "type": "object",
        "properties": {
          "createdAt": {
            "type": "integer",
            "description": "created_at is unix seconds.",
            "format": "int64"
          },
          "document": {
            "type": "string"
          },
          "id": {
            "type": "string"
          }
        }
      },
      "Attempt": {
        "title": "Attempt",
        "type": "object",
        "description": "Attempt is one run of a delegation over coins.",
        "properties": {
          "coins": {
            "type": "array",
            "description": "coins are the outpoints the attempt spends.",
            "items": {
              "type": "string"
            }
          },
          "createdAt": {
            "type": "integer",
            "description": "created_at and updated_at are unix seconds.",
            "format": "int64"
          },
          "delegationId": {
            "type": "integer",
            "format": "int64"
          },
          "error": {
            "type": "string",
            "description": "error says why a failed attempt failed."
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "kind": {
            "type": "string",
            "description": "kind is the delegation's template type: offchain or intent."
          },
          "status": {
            "type": "string",
            "description": "status is submitted, succeeded or failed."
          },
          "txid": {
            "type": "string",
            "description": "txid is the transaction once known: the ark txid of an offchain attempt, the commitment txid of a batched one."
          },
          "updatedAt": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "BatchForecast": {
        "title": "BatchForecast",
        "type": "object",
        "description": "BatchForecast is what a coming batch is expected to carry of ours.",
        "properties": {
          "amount": {
            "type": "integer",
            "format": "uint64"
          },
          "at": {
            "type": "integer",
            "description": "at is unix seconds.",
            "format": "int64"
          },
          "coins": {
            "type": "integer",
            "format": "int64"
          },
          "entries": {
            "type": "array",
            "description": "entries are the delegations in the batch, the first 100 at most.",
            "items": {
              "$ref": "#/components/schemas/ForecastEntry"
            }
          },
          "intents": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "CancelDelegationRequest": {
        "title": "CancelDelegationRequest",
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "CancelDelegationResponse": {
        "title": "CancelDelegationResponse",
        "type": "object"
      },
      "CancelStreamRequest": {
        "title": "CancelStreamRequest",
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "CancelStreamResponse": {
        "title": "CancelStreamResponse",
        "type": "object"
      },
      "Delegation": {
        "title": "Delegation",
        "type": "object",
        "properties": {
          "address": {
            "type": "string"
          },
          "createdAt": {
            "type": "integer",
            "description": "created_at and updated_at are unix seconds.",
            "format": "int64"
          },
          "expiresAt": {
            "type": "integer",
            "description": "expires_at is unix seconds, 0 when the delegation never expires.",
            "format": "int64"
          },
          "fingerprint": {
            "type": "string"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "inputs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Input"
            }
          },
          "status": {
            "type": "string",
            "description": "status is active, cancelled, expired or done."
          },
          "streamId": {
            "type": "integer",
            "description": "stream_id is the stream that spawned the delegation, 0 when a client registered it.",
            "format": "int64"
          },
          "templateId": {
            "type": "string"
          },
          "updatedAt": {
            "type": "integer",
            "format": "int64"
          },
          "variables": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "DelegationSummary": {
        "title": "DelegationSummary",
        "type": "object",
        "description": "DelegationSummary is a delegation with what its present coins and its attempts come to.",
        "properties": {
          "amount": {
            "type": "integer",
            "format": "uint64"
          },
          "coins": {
            "type": "integer",
            "format": "int64"
          },
          "delegation": {
            "$ref": "#/components/schemas/Delegation"
          },
          "lastAttempt": {
            "type": "string",
            "description": "last_attempt is the status of the newest attempt, empty without one."
          },
          "nextDue": {
            "type": "integer",
            "description": "next_due is unix seconds, the earliest due of the present coins, 0 without any.",
            "format": "int64"
          }
        }
      },
      "DeleteArtifactRequest": {
        "title": "DeleteArtifactRequest",
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        }
      },
      "DeleteArtifactResponse": {
        "title": "DeleteArtifactResponse",
        "type": "object"
      },
      "DeleteTemplateRequest": {
        "title": "DeleteTemplateRequest",
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        }
      },
      "DeleteTemplateResponse": {
        "title": "DeleteTemplateResponse",
        "type": "object"
      },
      "ForecastEntry": {
        "title": "ForecastEntry",
        "type": "object",
        "description": "ForecastEntry is a delegation's coins in a forecast batch.",
        "properties": {
          "amount": {
            "type": "integer",
            "format": "uint64"
          },
          "coins": {
            "type": "integer",
            "format": "int64"
          },
          "deadline": {
            "type": "integer",
            "format": "int64"
          },
          "delegationId": {
            "type": "integer",
            "format": "int64"
          },
          "due": {
            "type": "integer",
            "description": "due and deadline are unix seconds.",
            "format": "int64"
          }
        }
      },
      "GetHealthRequest": {
        "title": "GetHealthRequest",
        "type": "object"
      },
      "GetHealthResponse": {
        "title": "GetHealthResponse",
        "type": "object",
        "properties": {
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HealthEntry"
            }
          },
          "healthy": {
            "type": "boolean",
            "description": "healthy is whether every entry is."
          }
        }
      },
      "GetStatusRequest": {
        "title": "GetStatusRequest",
        "type": "object",
        "properties": {
          "horizonSeconds": {
            "type": "integer",
            "description": "horizon_seconds is how far ahead the batches are forecast, 0 for 24 hours, at most 7 days.",
            "format": "int64"
          }
        }
      },
      "GetStatusResponse": {
        "title": "GetStatusResponse",
        "type": "object",
        "properties": {
          "active": {
            "type": "integer",
            "description": "active is how many delegations are being served.",
            "format": "int64"
          },
          "amount": {
            "type": "integer",
            "description": "amount is the sum of those coins, in sats.",
            "format": "uint64"
          },
          "batches": {
            "type": "array",
            "description": "batches forecasts what the coming batches carry, the nearest first.",
            "items": {
              "$ref": "#/components/schemas/BatchForecast"
            }
          },
          "coins": {
            "type": "integer",
            "description": "coins is how many present coins the daemon watches.",
            "format": "int64"
          },
          "failed": {
            "type": "integer",
            "format": "uint64"
          },
          "late": {
            "type": "integer",
            "description": "late is how many coins are forecast to miss their deadline.",
            "format": "int64"
          },
          "maxIntents": {
            "type": "integer",
            "format": "int64"
          },
          "nextDue": {
            "type": "integer",
            "description": "next_due is unix seconds, when the next coin becomes ready, 0 when none will.",
            "format": "int64"
          },
          "queued": {
            "type": "integer",
            "description": "queued is how many entries wait to be registered at arkd.",
            "format": "int64"
          },
          "registered": {
            "type": "integer",
            "description": "registered is how many entries are registered at arkd, waiting for a batch.",
            "format": "int64"
          },
          "reserveSeconds": {
            "type": "integer",
            "description": "reserve_seconds is how long before expiry a coin enters a batch at the latest.",
            "format": "int64"
          },
          "sessionSeconds": {
            "type": "integer",
            "description": "session_seconds is how often arkd runs a batch, max_intents how many of ours one batch takes.",
            "format": "int64"
          },
          "succeeded": {
            "type": "integer",
            "description": "succeeded and failed count the attempts ended since the daemon started.",
            "format": "uint64"
          },
          "templateFailures": {
            "type": "integer",
            "description": "template_failures counts the failed attempts charged to their template since the daemon started.",
            "format": "uint64"
          },
          "tipHeight": {
            "type": "integer",
            "description": "tip_height is the chain's latest block, 0 before the first one is seen.",
            "format": "int64"
          }
        }
      },
      "HealthEntry": {
        "title": "HealthEntry",
