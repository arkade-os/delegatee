    "/v1/admin/delegate": {
      "get": {
        "tags": [
          "AdminService"
        ],
        "description": "ListDelegations lists one page, newest first.",
        "operationId": "AdminService_ListDelegations",
        "parameters": [
          {
            "name": "pageSize",
            "in": "query",
            "description": "page_size defaults to 100, at most 1000.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "cursor is the next_cursor of the previous page, 0 for the first.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "status filters when set: active, cancelled, expired or done.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "a successful response.",
            "content": {
