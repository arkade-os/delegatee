  "paths": {
    "/v1/admin/artifact/{id}": {
      "delete": {
        "tags": [
          "AdminService"
        ],
        "description": "DeleteArtifact fails with FailedPrecondition while a template references the artifact.",
        "operationId": "AdminService_DeleteArtifact",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "a successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteArtifactResponse"
                }
              }
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/artifacts": {
      "get": {
        "tags": [
          "AdminService"
        ],
        "description": "ListArtifacts lists artifacts without their documents, newest first.",
        "operationId": "AdminService_ListArtifacts",
        "responses": {
          "200": {
            "description": "a successful response.",
