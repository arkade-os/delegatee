              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListArtifactsResponse"
                }
              }
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/delegation/{id}/attempts": {
      "get": {
        "tags": [
          "AdminService"
        ],
        "description": "ListAttempts lists the attempts of a delegation newest first, paged by cursor.",
        "operationId": "AdminService_ListAttempts",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "cursor is the next_cursor of the previous page; 0 starts from the newest.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "limit is the page size: 100 when 0, at most 1000.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "a successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListAttemptsResponse"
                }
              }
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/delegation/{id}/cancel": {
      "post": {
        "tags": [
          "AdminService"
        ],
        "description": "CancelDelegation stops an active delegation; its fingerprint cannot be registered again until resumed.",
        "operationId": "AdminService_CancelDelegation",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "title": "CancelDelegationRequest",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "a successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CancelDelegationResponse"
                }
              }
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/delegation/{id}/resume": {
      "post": {
        "tags": [
          "AdminService"
        ],
        "description": "ResumeDelegation puts a cancelled delegation back to active.",
        "operationId": "AdminService_ResumeDelegation",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "title": "ResumeDelegationRequest",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "a successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResumeDelegationResponse"
                }
              }
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/delegations": {
      "get": {
        "tags": [
          "AdminService"
        ],
        "description": "ListDelegations lists delegations by the earliest due of their coins, those without coins last, paged by cursor.",
        "operationId": "AdminService_ListDelegations",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "description": "status filters on active, cancelled, expired or done; empty lists all.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "cursor is the next_cursor of the previous page; empty starts from the top.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "limit is the page size: 100 when 0, at most 1000.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "streamId",
            "in": "query",
            "description": "stream_id lists only the delegations the stream spawned; 0 lists all.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "templateId",
            "in": "query",
            "description": "template_id lists only the delegations of the template; empty lists all.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "a successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListDelegationsResponse"
                }
              }
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/health": {
      "get": {
        "tags": [
          "AdminService"
        ],
        "description": "GetHealth names each dependency with the error it answers, if any.",
        "operationId": "AdminService_GetHealth",
        "responses": {
          "200": {
            "description": "a successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetHealthResponse"
                }
              }
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/status": {
      "get": {
        "tags": [
          "AdminService"
        ],
        "description": "GetStatus reports what the loop holds: the queue, what is registered at arkd and the forecast batches.",
        "operationId": "AdminService_GetStatus",
        "parameters": [
          {
            "name": "horizonSeconds",
            "in": "query",
            "description": "horizon_seconds is how far ahead the batches are forecast, 0 for 24 hours, at most 7 days.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "a successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetStatusResponse"
                }
              }
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/stream": {
      "post": {
        "tags": [
          "AdminService"
        ],
        "description": "RegisterStream has the daemon run a template's trigger against arkd's transactions, spawning a delegation for each match.",
        "operationId": "AdminService_RegisterStream",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterStreamRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "a successful response.",
