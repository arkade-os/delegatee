{
  "openapi": "3.1.0",
  "info": {
    "title": "",
    "version": "version not set"
  },
  "paths": {
    "/v1/delegate": {
      "post": {
        "tags": [
          "DelegateeService"
        ],
        "description": "RegisterDelegation starts renewing the VTXOs locked at the address\nderived from the given tapscripts. The tapscripts must contain the\ndelegate tapscript GetInfo returns for the same params, and\nan exit leaf.",
        "operationId": "DelegateeService_RegisterDelegation",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDelegationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "a successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterDelegationResponse"
                }
              }
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/v1/delegate/{address}": {
      "get": {
        "tags": [
          "DelegateeService"
        ],
        "description": "GetDelegation returns a delegation with its spendable VTXOs (live from\nthe arkd indexer) and its renewal history.",
        "operationId": "DelegateeService_GetDelegation",
        "parameters": [
          {
            "name": "address",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "a successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetDelegationResponse"
                }
              }
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/v1/delegate/{address}/revoke": {
      "post": {
        "tags": [
          "DelegateeService"
        ],
        "description": "RevokeDelegation stops renewing the address on its owner's request,\nproven with a key of the exit leaf. Register again to resume.",
        "operationId": "DelegateeService_RevokeDelegation",
        "parameters": [
          {
            "name": "address",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "title": "RevokeDelegationRequest",
                "type": "object",
                "properties": {
                  "pubkey": {
                    "type": "string"
                  },
                  "signature": {
                    "type": "string",
                    "description": "TODO simplify ?"
                  },
                  "timestamp": {
                    "type": "integer",
                    "format": "int64"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "a successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RevokeDelegationResponse"
                }
              }
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/v1/info": {
      "get": {
        "tags": [
          "DelegateeService"
        ],
        "description": "GetInfo returns everything a wallet needs to build a delegate address\nit also returns the address itself would derive from the given params, so the wallet can verify it.\nparams are optional, and default to the values the server is configured with.",
        "operationId": "DelegateeService_GetInfo",
        "parameters": [
          {
            "name": "renewalWindow",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "maxFee",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "a successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetInfoResponse"
                }
              }
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
