                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/v1/spend": {
      "post": {
        "tags": [
          "DelegateeService"
        ],
        "description": "RegisterSpend spends outpoints once through a template, signed by their owner.",
        "operationId": "DelegateeService_RegisterSpend",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterSpendRequest"
