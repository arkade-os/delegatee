    }
  },
  "components": {
    "schemas": {
      "Any": {
        "type": "object",
        "description": "Any contains an arbitrary schema along with a URL to help identify the type of the schema.",
        "properties": {
          "@type": {
            "type": "string",
            "description": "A URL/resource name that uniquely identifies the type of the schema."
          }
        }
      },
      "Artifact": {
        "title": "Artifact",
        "type": "object",
        "properties": {
          "createdAt": {
            "type": "integer",
            "format": "int64"
          },
          "document": {
            "type": "string"
          },
          "id": {
            "type": "string"
          }
        }
      },
      "Asset": {
        "title": "Asset",
        "type": "object",
        "properties": {
          "amount": {
            "type": "integer",
            "format": "uint64"
          },
          "assetId": {
            "type": "string"
          }
        }
      },
      "Delegation": {
        "title": "Delegation",
        "type": "object",
        "description": "Delegation is an instance of a template.",
        "properties": {
          "address": {
            "type": "string",
            "description": "address is slot 0's address for a watch, empty otherwise."
          },
          "createdAt": {
            "type": "integer",
            "format": "int64"
          },
          "expiresAt": {
            "type": "integer",
            "description": "expires_at is 0 when the delegation never expires.",
            "format": "int64"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "parentId": {
            "type": "integer",
            "description": "parent_id is the delegation whose settled transaction advertised this one, 0 for a watch.",
            "format": "int64"
          },
          "slots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Slot"
            }
          },
          "status": {
            "type": "string",
            "description": "status is active, cancelled, expired or done."
          },
          "templateId": {
            "type": "string"
          },
          "updatedAt": {
            "type": "integer",
            "format": "int64"
          },
          "variables": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "GetArtifactRequest": {
        "title": "GetArtifactRequest",
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        }
      },
      "GetArtifactResponse": {
        "title": "GetArtifactResponse",
        "type": "object",
        "properties": {
          "artifact": {
            "$ref": "#/components/schemas/Artifact"
          }
        }
      },
      "GetDelegationRequest": {
        "title": "GetDelegationRequest",
        "type": "object",
        "properties": {
          "address": {
            "type": "string"
          }
        }
      },
      "GetDelegationResponse": {
        "title": "GetDelegationResponse",
        "type": "object",
        "properties": {
          "delegation": {
            "$ref": "#/components/schemas/Delegation"
          },
          "renewals": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Renewal"
            }
          },
          "vtxos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Vtxo"
            }
          }
        }
      },
      "GetInfoRequest": {
        "title": "GetInfoRequest",
        "type": "object"
      },
      "GetInfoResponse": {
        "title": "GetInfoResponse",
        "type": "object",
        "properties": {
          "delegatePubkey": {
            "type": "string"
          },
          "emulatorPubkey": {
            "type": "string"
          },
          "encryptionPubkey": {
            "type": "string",
            "description": "encryption_pubkey seals template secrets for this daemon; empty without an encryption key."
          },
          "network": {
            "type": "string"
          },
          "serverPubkey": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "GetSpendRequest": {
        "title": "GetSpendRequest",
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        }
      },
      "GetSpendResponse": {
        "title": "GetSpendResponse",
        "type": "object",
        "properties": {
          "delegation": {
            "$ref": "#/components/schemas/Delegation"
          },
          "renewals": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Renewal"
            }
          },
          "vtxos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Vtxo"
            }
          }
        }
      },
      "GetTemplateRequest": {
        "title": "GetTemplateRequest",
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        }
      },
      "GetTemplateResponse": {
        "title": "GetTemplateResponse",
        "type": "object",
        "properties": {
          "template": {
            "$ref": "#/components/schemas/Template"
          }
        }
      },
      "ListTemplatesRequest": {
        "title": "ListTemplatesRequest",
        "type": "object",
        "description": "ListTemplatesRequest has no fields: the public list is always the active one."
      },
      "ListTemplatesResponse": {
        "title": "ListTemplatesResponse",
        "type": "object",
        "properties": {
          "templates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Template"
            }
          }
        }
      },
      "Param": {
        "title": "Param",
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        }
      },
      "RegisterArtifactRequest": {
        "title": "RegisterArtifactRequest",
        "type": "object",
        "properties": {
          "document": {
            "type": "string"
          }
        }
      },
      "RegisterArtifactResponse": {
        "title": "RegisterArtifactResponse",
        "type": "object",
        "properties": {
          "artifact": {
            "$ref": "#/components/schemas/Artifact"
          }
        }
      },
      "RegisterDelegationRequest": {
        "title": "RegisterDelegationRequest",
        "type": "object",
        "properties": {
          "expiresAt": {
            "type": "integer",
            "description": "expires_at is a unix time after which the watch stops; 0 never expires.",
            "format": "int64"
          },
          "templateId": {
            "type": "string"
          },
          "variables": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "RegisterDelegationResponse": {
        "title": "RegisterDelegationResponse",
        "type": "object",
        "properties": {
          "delegation": {
            "$ref": "#/components/schemas/Delegation"
          }
        }
      },
      "RegisterSpendRequest": {
        "title": "RegisterSpendRequest",
        "type": "object",
        "properties": {
          "expiresAt": {
            "type": "integer",
            "format": "int64"
          },
          "outpoints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pubkey": {
            "type": "string"
          },
          "signature": {
            "type": "string"
          },
          "templateId": {
            "type": "string"
          },
          "variables": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "RegisterSpendResponse": {
        "title": "RegisterSpendResponse",
        "type": "object",
        "properties": {
          "delegation": {
            "$ref": "#/components/schemas/Delegation"
          },
          "id": {
            "type": "string",
            "description": "id is the spend's fingerprint."
          }
        }
      },
      "RegisterTemplateRequest": {
        "title": "RegisterTemplateRequest",
        "type": "object",
        "properties": {
          "document": {
            "type": "string"
          }
        }
      },
      "RegisterTemplateResponse": {
        "title": "RegisterTemplateResponse",
        "type": "object",
        "properties": {
          "template": {
            "$ref": "#/components/schemas/Template"
          }
        }
      },
      "Renewal": {
        "title": "Renewal",
        "type": "object",
        "properties": {
          "attemptedAt": {
            "type": "integer",
            "format": "int64"
          },
          "commitmentTxid": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "outpoints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "success": {
            "type": "boolean"
          }
        }
      },
      "Slot": {
        "title": "Slot",
        "type": "object",
        "description": "Slot is one template input of a delegation.",
        "properties": {
          "name": {
            "type": "string"
          },
          "onchain": {
            "type": "boolean"
          },
          "outpoint": {
            "type": "string",
            "description": "outpoint is \"txid:vout\" when bound, empty for a watch."
          },
          "tapscripts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Status": {
        "title": "Status",
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "details": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Any"
            }
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Template": {
        "title": "Template",
        "type": "object",
        "properties": {
          "artifactIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "createdAt": {
            "type": "integer",
            "format": "int64"
          },
          "document": {
            "type": "string",
            "description": "empty in list responses"
          },
          "id": {
            "type": "string"
          },
          "params": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Param"
            }
          },
          "status": {
            "type": "string"
          }
        }
      },
      "Vtxo": {
        "title": "Vtxo",
        "type": "object",
        "properties": {
          "amount": {
            "type": "integer",
            "format": "uint64"
          },
          "assets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Asset"
            }
          },
          "createdAt": {
            "type": "integer",
            "format": "int64"
          },
          "expiresAt": {
            "type": "integer",
            "format": "int64"
          },
          "onchain": {
            "type": "boolean"
          },
          "outpoint": {
            "type": "string"
          },
          "preconfirmed": {
            "type": "boolean"
          },
          "renewableAt": {
            "type": "integer",
            "format": "int64"
          }
        }
