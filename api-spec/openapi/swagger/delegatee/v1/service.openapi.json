{
  "openapi": "3.1.0",
  "info": {
    "title": "",
    "version": "version not set"
  },
  "paths": {
    "/v1/admin/delegate": {
      "get": {
        "tags": [
          "AdminService"
        ],
        "description": "ListDelegations returns every registered delegation.",
        "operationId": "AdminService_ListDelegations",
        "responses": {
          "200": {
            "description": "a successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListDelegationsResponse"
                }
              }
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/delegate/{address}": {
      "delete": {
        "tags": [
          "AdminService"
        ],
        "description": "CancelDelegation stops renewing the address. Register again to resume.",
        "operationId": "AdminService_CancelDelegation",
        "parameters": [
          {
            "name": "address",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "a successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CancelDelegationResponse"
                }
              }
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/status": {
      "get": {
        "tags": [
          "AdminService"
        ],
        "description": "GetStatus returns the scanner's state and what arkd charges right now.",
        "operationId": "AdminService_GetStatus",
        "responses": {
          "200": {
            "description": "a successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetStatusResponse"
                }
              }
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/v1/delegate": {
      "post": {
        "tags": [
          "DelegateeService"
        ],
        "description": "RegisterDelegation starts renewing the VTXOs locked at the address\nderived from the given tapscripts. The tapscripts must contain the\ndelegate tapscript GetInfo returns for the same params, and\nan exit leaf.",
        "operationId": "DelegateeService_RegisterDelegation",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDelegationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "a successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterDelegationResponse"
                }
              }
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/v1/delegate/{address}": {
      "get": {
        "tags": [
          "DelegateeService"
        ],
        "description": "GetDelegation returns a delegation with its spendable VTXOs (live from\nthe arkd indexer) and its renewal history.",
        "operationId": "DelegateeService_GetDelegation",
        "parameters": [
          {
            "name": "address",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "a successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetDelegationResponse"
                }
              }
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/v1/delegate/{address}/revoke": {
      "post": {
        "tags": [
          "DelegateeService"
        ],
        "description": "RevokeDelegation stops renewing the address on its owner's request,\nproven with a key of the exit leaf. Register again to resume.",
        "operationId": "DelegateeService_RevokeDelegation",
        "parameters": [
          {
            "name": "address",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "title": "RevokeDelegationRequest",
                "type": "object",
                "properties": {
                  "pubkey": {
                    "type": "string",
                    "description": "hex, x-only or compressed: a key of the exit leaf of the vtxo script."
                  },
                  "signature": {
                    "type": "string",
                    "description": "hex BIP340 signature by that key over\ntagged_hash(\"delegatee/revoke\", \"\u003caddress\u003e:\u003ctimestamp\u003e\")."
                  },
                  "timestamp": {
                    "type": "integer",
                    "description": "unix seconds, must be within 10 minutes of the server's clock.",
                    "format": "int64"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "a successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RevokeDelegationResponse"
                }
              }
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/v1/info": {
      "get": {
        "tags": [
          "DelegateeService"
        ],
        "description": "GetInfo returns everything a wallet needs to build a delegate address\nfor the given params: the delegate cosigner pubkey, the covenant\nand the delegate tapscript.",
        "operationId": "DelegateeService_GetInfo",
        "parameters": [
          {
            "name": "renewalWindow",
            "in": "query",
            "description": "seconds before expiry from which a VTXO may be renewed. Defaults to 1024.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "maxFee",
            "in": "query",
            "description": "most sats one renewal may deduct from a VTXO to pay the arkd intent fee.\nDefaults to 0: the VTXO is only renewed while arkd charges nothing for it.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "a successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetInfoResponse"
                }
              }
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Any": {
        "type": "object",
        "description": "Any contains an arbitrary schema along with a URL to help identify the type of the schema.",
        "properties": {
          "@type": {
            "type": "string",
            "description": "A URL/resource name that uniquely identifies the type of the schema."
          }
        }
      },
      "Asset": {
        "title": "Asset",
        "type": "object",
        "properties": {
          "amount": {
            "type": "integer",
            "format": "uint64"
          },
          "assetId": {
            "type": "string"
          }
        }
      },
      "CancelDelegationRequest": {
        "title": "CancelDelegationRequest",
        "type": "object",
        "properties": {
          "address": {
            "type": "string"
          }
        }
      },
      "CancelDelegationResponse": {
        "title": "CancelDelegationResponse",
        "type": "object"
      },
      "Delegation": {
        "title": "Delegation",
        "type": "object",
        "properties": {
          "address": {
            "type": "string"
          },
          "createdAt": {
            "type": "integer",
            "format": "int64"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "lastRenewal": {
            "$ref": "#/components/schemas/Renewal",
            "description": "most recent renewal attempt, only set by ListDelegations."
          },
          "managed": {
            "type": "boolean",
            "description": "what the last scan saw at the address, only set by ListDelegations for\nactive delegations. managed is false when the delegation was registered\nunder another secret key: this instance cannot renew it."
          },
          "maxFee": {
            "type": "integer",
            "format": "int64"
          },
          "nextExpiry": {
            "type": "integer",
            "description": "earliest expiry among its VTXOs, 0 without any.",
            "format": "int64"
          },
          "nextRenewalAt": {
            "type": "integer",
            "description": "when the first of its VTXOs becomes renewable, 0 without any.",
            "format": "int64"
          },
          "renewalWindow": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "type": "string",
            "description": "active | cancelled (by the operator) | revoked (by the owner)"
          },
          "tapscripts": {
            "type": "array",
            "description": "not set by ListDelegations.",
            "items": {
              "type": "string"
            }
          },
          "totalAmount": {
            "type": "integer",
            "format": "uint64"
          },
          "updatedAt": {
            "type": "integer",
            "format": "int64"
          },
          "vtxoCount": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "GetDelegationRequest": {
        "title": "GetDelegationRequest",
        "type": "object",
        "properties": {
          "address": {
            "type": "string"
          }
        }
      },
      "GetDelegationResponse": {
        "title": "GetDelegationResponse",
        "type": "object",
        "properties": {
          "delegation": {
            "$ref": "#/components/schemas/Delegation"
          },
          "renewals": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Renewal"
            }
          },
          "vtxos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Vtxo"
            }
          }
        }
      },
      "GetInfoRequest": {
        "title": "GetInfoRequest",
        "type": "object",
        "properties": {
          "maxFee": {
            "type": "integer",
            "description": "most sats one renewal may deduct from a VTXO to pay the arkd intent fee.\nDefaults to 0: the VTXO is only renewed while arkd charges nothing for it.",
            "format": "int64"
          },
          "renewalWindow": {
            "type": "integer",
            "description": "seconds before expiry from which a VTXO may be renewed. Defaults to 1024.",
            "format": "int64"
          }
        }
      },
      "GetInfoResponse": {
        "title": "GetInfoResponse",
        "type": "object",
        "properties": {
          "arkadeScript": {
            "type": "string",
            "description": "hex-encoded arkade script executed by the emulator before co-signing."
          },
          "delegatePubkey": {
            "type": "string",
            "description": "hex-encoded compressed pubkey of the vtxo tree cosigner pinned in the covenant."
          },
          "delegateTapscript": {
            "type": "string",
            "description": "hex-encoded tapscript of the delegate leaf: [server_pubkey, emulator_tweaked_pubkey]."
          },
          "emulatorPubkey": {
            "type": "string",
            "description": "hex-encoded compressed pubkey of the emulator."
          },
          "emulatorTweakedPubkey": {
            "type": "string",
            "description": "emulator pubkey tweaked with the covenant hash, second key of the delegate leaf."
          },
          "maxFee": {
            "type": "integer",
            "format": "int64"
          },
          "network": {
            "type": "string"
          },
          "renewalWindow": {
            "type": "integer",
            "format": "int64"
          },
          "serverPubkey": {
            "type": "string",
            "description": "hex-encoded compressed pubkey of the arkd signer."
          },
          "version": {
            "type": "string"
          }
        }
      },
      "GetStatusRequest": {
        "title": "GetStatusRequest",
        "type": "object"
      },
      "GetStatusResponse": {
        "title": "GetStatusResponse",
        "type": "object",
        "properties": {
          "intentFees": {
            "$ref": "#/components/schemas/IntentFees",
            "description": "unset when arkd is unreachable."
          },
          "lastScanAt": {
            "type": "integer",
            "description": "unix time of the last completed scan, 0 before the first one.",
            "format": "int64"
          },
          "pollInterval": {
            "type": "integer",
            "description": "seconds between scans.",
            "format": "int64"
          },
          "renewingVtxos": {
            "type": "integer",
            "description": "VTXOs in the batch session in flight, 0 when idle. Scans pause meanwhile.",
            "format": "int32"
          }
        }
      },
      "IntentFees": {
        "title": "IntentFees",
        "type": "object",
        "description": "IntentFees are arkd's fee programs (CEL), empty when nothing is charged.",
        "properties": {
          "offchainInput": {
            "type": "string"
          },
          "offchainOutput": {
            "type": "string"
          },
          "onchainInput": {
            "type": "string"
          },
          "onchainOutput": {
            "type": "string"
          }
        }
      },
      "ListDelegationsRequest": {
        "title": "ListDelegationsRequest",
        "type": "object"
      },
      "ListDelegationsResponse": {
        "title": "ListDelegationsResponse",
        "type": "object",
        "properties": {
          "delegations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Delegation"
            }
          }
        }
      },
      "RegisterDelegationRequest": {
        "title": "RegisterDelegationRequest",
        "type": "object",
        "properties": {
          "maxFee": {
            "type": "integer",
            "format": "int64"
          },
          "renewalWindow": {
            "type": "integer",
            "description": "the params the delegate tapscript was built for, same defaults as GetInfo.",
            "format": "int64"
          },
          "tapscripts": {
            "type": "array",
            "description": "hex-encoded tapscripts of the vtxo script, as encoded by the SDKs.",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "RegisterDelegationResponse": {
        "title": "RegisterDelegationResponse",
        "type": "object",
        "properties": {
          "delegation": {
            "$ref": "#/components/schemas/Delegation"
          }
        }
      },
      "Renewal": {
        "title": "Renewal",
        "type": "object",
        "properties": {
          "attemptedAt": {
            "type": "integer",
            "format": "int64"
          },
          "commitmentTxid": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "outpoints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "success": {
            "type": "boolean"
          }
        }
      },
      "RevokeDelegationRequest": {
        "title": "RevokeDelegationRequest",
        "type": "object",
        "properties": {
          "address": {
            "type": "string"
          },
          "pubkey": {
            "type": "string",
            "description": "hex, x-only or compressed: a key of the exit leaf of the vtxo script."
          },
          "signature": {
            "type": "string",
            "description": "hex BIP340 signature by that key over\ntagged_hash(\"delegatee/revoke\", \"\u003caddress\u003e:\u003ctimestamp\u003e\")."
          },
          "timestamp": {
            "type": "integer",
            "description": "unix seconds, must be within 10 minutes of the server's clock.",
            "format": "int64"
          }
        }
      },
      "RevokeDelegationResponse": {
        "title": "RevokeDelegationResponse",
        "type": "object"
      },
      "Status": {
        "title": "Status",
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "details": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Any"
            }
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Vtxo": {
        "title": "Vtxo",
        "type": "object",
        "properties": {
          "amount": {
            "type": "integer",
            "format": "uint64"
          },
          "assets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Asset"
            }
          },
          "createdAt": {
            "type": "integer",
            "format": "int64"
          },
          "expiresAt": {
            "type": "integer",
            "format": "int64"
          },
          "outpoint": {
            "type": "string",
            "description": "txid:vout"
          },
          "preconfirmed": {
            "type": "boolean"
          },
          "renewableAt": {
            "type": "integer",
            "description": "when it becomes renewable.",
            "format": "int64"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "DelegateeService"
    },
    {
      "name": "AdminService"
    }
  ]
}
